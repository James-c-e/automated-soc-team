{"name":"PAN-OS Allowed VNC TCP/5900 Activity","description":"Detects repeated allowed PAN-OS traffic to VNC TCP/5900 from internal sources. Blocked scans are excluded; the threshold requires repeated activity for the same source and destination.","risk_score":47,"severity":"medium","output_index":"","version":1,"tags":["Tactic: Command and Control","Technique: T1219","Data Source: PAN-OS","Use Case: Threat Detection"],"enabled":true,"risk_score_mapping":[],"severity_mapping":[],"interval":"5m","from":"now-9m","to":"now","actions":[],"exceptions_list":[],"author":["SOC Analyst"],"false_positives":[],"references":[],"max_signals":5,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0011","name":"Command and Control","reference":"https://attack.mitre.org/tactics/TA0011/"},"technique":[{"id":"T1219","name":"Remote Access Software","reference":"https://attack.mitre.org/techniques/T1219/"}]}],"setup":"","related_integrations":[],"required_fields":[],"id":"b8425e44-58a2-4f74-9685-41c42938c169","rule_id":"dd14d64a-2ddb-4d0e-b0a6-f8ccd4ffb6e8","immutable":false,"rule_source":{"type":"internal"},"updated_at":"2026-09-18T19:11:55.702Z","updated_by":"security@securecloudplus.co.uk","created_at":"2026-09-18T19:11:55.702Z","created_by":"security@securecloudplus.co.uk","revision":0,"type":"threshold","query":"event.dataset:\"panw.panos\" and panw.panos.type:\"TRAFFIC\" and network.transport:tcp and destination.port:5900 and panw.panos.action:allow and event.action:flow_started and source.ip:(10.0.0.0/8 or 172.16.0.0/12 or 192.168.0.0/16)","threshold":{"field":["source.ip","destination.ip"],"value":3},"index":["packetbeat-*","auditbeat-*","filebeat-*","logs-network_traffic.*","logs-panw.panos*"],"language":"kuery"}
