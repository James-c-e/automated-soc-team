  "create_response": {
    "name": "Internal SSH Authentication Failure Burst",
    "description": "Detects repeated failed SSH authentication from a source against a host and username within a ten-minute window. This is a threshold analytic for password guessing; it does not prove a successful login or compromise.",
    "risk_score": 47,
    "severity": "medium",
    "note": "## Triage and analysis\n\nInvestigate the source host, target host, username, authentication method, and adjacent successful logins. Exclude only approved administrative jump hosts or authorized scanners after validation. A match indicates repeated failed authentication, not successful access.\n\nThis rule is intentionally generic and does not hardcode any source IP.",
