{
  "size": 0,
  "track_total_hits": true,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "now-24h",
              "lte": "now"
            }
          }
        },
        {
          "term": {
            "event.dataset": "system.auth"
          }
        },
        {
          "term": {
            "event.action": "ssh_login"
          }
        },
        {
          "term": {
            "event.outcome": "failure"
          }
        },
        {
          "exists": {
            "field": "source.ip"
          }
        },
        {
          "exists": {
            "field": "user.name"
          }
        }
      ]
    }
  },
  "aggs": {
    "by_source": {
      "terms": {
        "field": "source.ip",
        "size": 50
      },
      "aggs": {
        "by_host": {
          "terms": {
            "field": "host.name",
            "size": 50
          },
          "aggs": {
            "by_user": {
              "terms": {
                "field": "user.name",
                "size": 50
              }
            }
          }
        }
      }
    },
    "by_source_address": {
      "terms": {
        "field": "source.address",
        "size": 50
      }
    },
    "by_host": {
      "terms": {
        "field": "host.name",
        "size": 50
      }
    },
    "by_user": {
      "terms": {
        "field": "user.name",
        "size": 50
      }
    }
  }
}
