{"name":"Palo Alto Device Low Event","description":"This rule detects Palo Alto logs classified as Low severity (event.severity: 4). Low severity events are generally informational or low-risk security events that may provide useful context during investigations or trend analysis.","risk_score":21,"severity":"low","license":"","note":"","output_index":"","version":1,"tags":[],"enabled":true,"risk_score_mapping":[],"severity_mapping":[],"interval":"5m","from":"now-6m","to":"now","actions":[],"exceptions_list":[],"author":[],"false_positives":[],"references":[],"max_signals":100,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0001","name":"Initial Access","reference":"https://attack.mitre.org/tactics/TA0001/"},"technique":[{"id":"T1190","name":"Exploit Public-Facing Application","reference":"https://attack.mitre.org/techniques/T1190/"}]}],"setup":"","related_integrations":[],"required_fields":[],"id":"a97642fb-b94b-4f2b-a44c-b7603b7248cc","rule_id":"57348ab4-99c7-4b6e-b15f-604ac0c4300e","immutable":false,"rule_source":{"type":"internal"},"updated_at":"2026-09-18T19:00:19.354Z","updated_by":"security@securecloudplus.co.uk","created_at":"2026-09-13T16:17:32.468Z","created_by":"security@securecloudplus.co.uk","revision":3,"type":"query","index":["apm-*-transaction*","auditbeat-*","endgame-*","filebeat-*","logs-*","packetbeat-*","traces-apm*","winlogbeat-*","-*elastic-cloud-logs-*"],"query":"event.dataset:\"panw.panos\" and panw.panos.type:\"THREAT\" and event.kind:alert and event.severity:4","language":"kuery"}