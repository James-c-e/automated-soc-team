{"name":"PAN-OS Repeated Sensitive-Service Access","description":"Detects an internal source contacting at least 10 internal destinations on sensitive service ports, excluding expected Elastic API traffic on port 9200 and duplicate flow termination events.","risk_score":47,"severity":"medium","note":"Created for the current Security Onion PAN-OS schema.","output_index":"","version":1,"tags":["PAN-OS","SecurityOnion","Custom"],"enabled":true,"risk_score_mapping":[],"severity_mapping":[],"interval":"5m","from":"now-9m","to":"now","actions":[],"exceptions_list":[],"author":["SecurityOnion"],"false_positives":[],"references":[],"max_signals":100,"threat":[{"framework":"MITRE ATT&CK","tactic":{"id":"TA0008","name":"Lateral Movement","reference":"https://attack.mitre.org/tactics/TA0008/"},"technique":[{"id":"T1021","name":"Remote Services","reference":"https://attack.mitre.org/techniques/T1021/"}]},{"framework":"MITRE ATT&CK","tactic":{"id":"TA0007","name":"Discovery","reference":"https://attack.mitre.org/tactics/TA0007/"},"technique":[{"id":"T1046","name":"Network Service Scanning","reference":"https://attack.mitre.org/techniques/T1046/"}]}],"setup":"","related_integrations":[{"package":"panw","version":">=5.0.0"}],"required_fields":[],"id":"50457dc6-b2ee-41ec-889b-abd4af8527b6","rule_id":"818a5377-ab99-41f7-a0e8-0c81a9d73759","immutable":false,"rule_source":{"type":"internal"},"updated_at":"2026-09-18T18:59:54.926Z","updated_by":"security@securecloudplus.co.uk","created_at":"2026-09-13T22:07:27.202Z","created_by":"security@securecloudplus.co.uk","revision":2,"type":"threshold","query":"event.dataset:\"panw.panos\" and panw.panos.type:\"TRAFFIC\" and panw.panos.action:allow and event.action:flow_started and destination.port:(22 or 23 or 135 or 139 or 445 or 3389 or 5985 or 5986) and source.ip:(10.0.0.0/8 or 172.16.0.0/12 or 192.168.0.0/16)","threshold":{"field":["source.ip"],"value":1,"cardinality":[{"field":"destination.ip","value":10}]},"index":["logs-panw.panos*"],"language":"kuery"}